<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Forge</title>
<link rel="preconnect" href="https://fonts.googleapis.com"><link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet">
<style>
:root{--bg:#16171a;--card:#23252a;--text:#e6e6e6;--a1:#8d99ae;--a2:#edf2f4}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--text);font:10px/1.7 "Press Start 2P",ui-monospace,monospace;padding:env(safe-area-inset-top,0) 0 calc(76px + env(safe-area-inset-bottom,0))}
main{max-width:480px;margin:0 auto;padding:14px}
.c{background:var(--card);border:4px solid var(--a1);box-shadow:4px 4px 0 #000;padding:12px;margin-bottom:14px}
h1,h2{font-size:12px;margin:0 0 10px;color:var(--a2)} h1{font-size:16px;text-align:center}
.m{color:var(--a1);font-size:8px}
button,input,select{font:inherit;color:var(--text)}
button{background:var(--a1);color:#000;border:4px solid #000;box-shadow:3px 3px 0 #000;padding:9px 10px;cursor:pointer}
button:active{transform:translate(3px,3px);box-shadow:none}
button.g{background:var(--card);color:var(--text);border-color:var(--a1)}
button:disabled{opacity:.4}
input,select{width:100%;background:var(--bg);border:4px solid var(--a1);padding:9px;margin:4px 0 10px}
input[type=color]{padding:0;height:40px}
label{font-size:8px;color:var(--a1)}
.r{display:flex;gap:8px;align-items:center;justify-content:space-between}
.bar{height:16px;border:4px solid #000;background:#000;margin:6px 0}.bar i{display:block;height:100%;background:var(--a2);width:0}
.bar.h i{background:var(--a1)}
.nav{position:fixed;left:0;right:0;bottom:0;display:flex;gap:6px;padding:8px 8px calc(8px + env(safe-area-inset-bottom,0));background:#000}
.nav button{flex:1;font-size:8px}
.pet{width:168px;height:144px;image-rendering:pixelated;display:block;margin:6px auto;animation:bob 1s steps(2) infinite}
.pet.hungry{filter:saturate(.5)}.pet.critical{filter:grayscale(1);animation:sh .3s steps(2) infinite}.pet.dim{opacity:.55}
@keyframes bob{50%{transform:translateY(-6px)}}@keyframes sh{50%{transform:translateX(4px)}}
.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
.pk{border:4px solid var(--a1);background:var(--bg);padding:4px;text-align:center;font-size:7px;color:var(--text)}
.pk img{width:100%;image-rendering:pixelated}.pk.sel{border-color:var(--a2);background:var(--card)}.pk.lk{opacity:.4}
.sw{display:flex;gap:4px;flex-wrap:wrap}.sw button{font-size:7px;padding:6px}
.q.done{border-color:var(--a2)}
#toast{position:fixed;left:50%;top:calc(14px + env(safe-area-inset-top,0));transform:translateX(-50%);background:#000;color:var(--a2);border:4px solid var(--a2);padding:8px 12px;display:none;z-index:9;text-align:center}
.lock{border-color:var(--a2);text-align:center}
.err{color:#ff6b6b;font-size:8px;margin:6px 0}
.top{display:flex;justify-content:space-between;align-items:center;padding:10px 12px;border-bottom:4px solid var(--a1);position:sticky;top:0;background:var(--bg);z-index:4}
.top button{padding:6px 12px;font-size:14px}
.stage{position:relative;display:flex;flex-direction:column;align-items:center;padding:22px 14px 190px;min-height:calc(100vh - 140px)}
.start{width:80%;max-width:340px;font-size:20px;padding:22px}
.fig{position:relative;width:120px;margin-top:46px;z-index:2}.fig img{width:120px;image-rendering:pixelated;display:block}
.fig .pfp{position:absolute;left:30px;top:0;width:60px;height:60px;border-radius:50%;object-fit:cover;border:4px solid #000;image-rendering:auto}
.plat{width:250px;height:56px;border:4px solid var(--a1);border-radius:50%;background:var(--card);margin-top:-30px}
.pet.sm{position:absolute;right:4%;bottom:205px;width:112px;height:96px;cursor:pointer;margin:0}
.pn{margin-top:14px;text-align:center}
.dock{position:fixed;left:0;right:0;bottom:0;z-index:5;background:#000;padding-bottom:env(safe-area-inset-bottom,0)}
.sheet{max-height:55vh;overflow:auto;background:var(--bg);border-top:4px solid var(--a1);padding:12px}
.tg{margin:6px 8px;padding:4px 14px;font-size:10px}
.nav2{display:flex;gap:6px;padding:0 8px 8px}.nav2 button{flex:1;font-size:8px}
.scrim{position:fixed;inset:0;background:#0009;z-index:6}
.drawer{position:fixed;left:0;top:0;bottom:0;width:78%;max-width:320px;background:var(--bg);border-right:4px solid var(--a1);padding:16px;z-index:7;overflow:auto}
.modal{position:fixed;left:50%;top:30%;transform:translateX(-50%);width:84%;max-width:360px;z-index:7}
body{padding:0}
.app{display:flex;flex-direction:column;height:100dvh;padding-top:env(safe-area-inset-top,0)}
.stage{flex:1;min-height:0;overflow:hidden;padding:12px 14px;justify-content:center;gap:14px}
.stage .start{font-size:18px;padding:16px}
.fig{margin-top:0}
.scene{position:relative;display:flex;flex-direction:column;align-items:center}
.scene .pet.sm{position:absolute;right:-24px;bottom:6px;width:100px;height:86px}
.dock{position:relative;flex:none}
.sheet{height:42vh;max-height:none}
.app.open .start{font-size:12px;padding:8px}
.app.open .fig,.app.open .fig img{width:84px}
.app.open .fig .pfp{left:21px;width:42px;height:42px}
.app.open .plat{width:170px;height:36px;margin-top:-20px}
.app.open .scene .pet.sm{width:72px;height:62px;right:-10px}
.pp{display:grid;grid-template-columns:40% 1fr;gap:10px}
.pbox{border:4px solid var(--a1);border-radius:18px;background:var(--card);padding:6px;margin-bottom:6px}
.pbox .pet{width:100%;height:auto;margin:0}
.pgrid{display:grid;grid-template-columns:repeat(3,1fr);gap:6px;align-content:start}
.fb{display:block;background:var(--a1);color:#000;border:4px solid #000;box-shadow:3px 3px 0 #000;padding:10px;cursor:pointer;text-align:center;margin:4px 0 10px}
.big{font-size:36px;text-align:center;margin:8px 0}
.list{border:4px solid var(--a1);height:44vh;overflow:auto;padding:8px;background:var(--card)}
.ex{display:flex;justify-content:space-between;align-items:center;gap:8px;border-bottom:4px solid var(--bg);padding:8px 4px}
.ex.done b{opacity:.5;text-decoration:line-through}
.ck{width:44px;height:44px;flex:none;border-radius:50%;background:var(--bg);color:#000;border:4px solid var(--a1);padding:0;box-shadow:none;font-size:14px}
.ex.done .ck{background:var(--a2)}
.plan{cursor:pointer;text-decoration:underline;text-align:center}
.hud{width:100%;max-width:340px}
.app.open .hud{display:none}
body.crt::after{content:"";position:fixed;inset:0;pointer-events:none;background:repeating-linear-gradient(0deg,#0000 0 2px,#0003 2px 3px);z-index:20}
.pet.hop{animation:hop .5s steps(4)}
@keyframes hop{50%{transform:translateY(-22px)}}
.cf{position:fixed;top:-10px;width:8px;height:8px;z-index:30;animation:fall 1.6s steps(12) forwards;pointer-events:none}
@keyframes fall{to{transform:translateY(105vh)}}
.pg{max-width:480px;margin:0 auto;padding-bottom:86px}
.hint{text-align:center;font-size:8px;color:var(--a1);margin:16px 0 4px}
.sc{display:grid;grid-template-columns:1fr 120px 1fr;align-items:end;gap:6px;padding:0 10px}
.desk,.sign{background:none;border:0;box-shadow:none;color:var(--text);padding:4px;font-size:8px;text-align:center}
.desk img{border-bottom:4px solid var(--a1);padding-bottom:2px}
.sign .bd{background:var(--a1);color:#000;border:4px solid #000;padding:10px 4px;font-size:11px}
.sign .po{width:8px;height:46px;background:var(--a1);border:2px solid #000;margin:0 auto}
.sign .pl{font-size:7px;color:var(--a2);margin-top:4px;text-decoration:underline}
.pg .plat{margin:-26px auto 0}
.hud2{padding:12px 16px}
.pc{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:0 12px;border:4px solid var(--a1);padding:10px;background:var(--card)}
.shop{border:4px solid var(--a1);background:var(--bg);display:flex;flex-direction:column;height:310px}
.shop .li{overflow:auto;flex:1;padding:4px 6px}
.sr{display:flex;justify-content:space-between;align-items:center;gap:6px;border-bottom:2px solid var(--a1);padding:6px 0}
.sheet2{position:fixed;left:0;right:0;bottom:calc(62px + env(safe-area-inset-bottom,0px));height:55vh;overflow:auto;background:var(--bg);border-top:4px solid var(--a1);padding:12px;z-index:5}
.sheet2 .x{float:right;font-size:8px;padding:4px 8px}
.tabs2{position:fixed;left:0;right:0;bottom:0;display:flex;gap:6px;padding:8px 8px calc(8px + env(safe-area-inset-bottom,0px));background:#000;z-index:6}
.tabs2 button{flex:1;font-size:8px}
.page{position:fixed;inset:0;background:var(--bg);z-index:8;overflow:auto;padding:14px 14px 30px}
.sw1{width:34px;height:34px;padding:0}
.lg{display:grid;grid-template-columns:repeat(7,1fr);gap:4px}
.lc{aspect-ratio:1;background:var(--bg);border:3px solid var(--a1)}.lc.w{background:var(--a2)}.lc.r{background:var(--a1)}
.plat.grass{background:#2e7d32;border-color:#8bc34a}.plat.space{background:#1a1040;border-color:#7e57c2}.plat.lava{background:#5a1a0a;border-color:#ff6d00}
.rep{width:54px;margin:0;padding:6px;font-size:9px}
.bossc{margin:12px 12px 0;border:4px solid var(--a1);background:var(--card);padding:8px;display:flex;gap:10px;align-items:center}
.bossc img{width:56px;image-rendering:pixelated;flex:none}.bossc>div{flex:1}
.chart{width:100%;background:var(--bg);border:4px solid var(--a1)}.chart polyline{fill:none;stroke:var(--a2);stroke-width:2}.chart circle{fill:var(--a1)}
.plat.gold{background:#7a5c00;border-color:#ffd54f}
</style></head><body>
<div id="app"></div><div id="toast"></div>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.45.4/dist/umd/supabase.min.js"></script>
<script>window.FQ_CONFIG={url:"",key:""}; // paste your Supabase URL + anon key here</script>
<script>
const $=q=>document.querySelector(q),esc=s=>String(s??"").replace(/[&<>"]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]));
const CFG=window.FQ_CONFIG,sb=CFG.url&&window.supabase?supabase.createClient(CFG.url,CFG.key):null;
const dk=(d=new Date())=>d.getFullYear()+"-"+String(d.getMonth()+1).padStart(2,"0")+"-"+String(d.getDate()).padStart(2,"0");
const gap=(a,b)=>Math.round((new Date(a)-new Date(b))/864e5);
const age=s=>{const[y,m,d]=s.split("-").map(Number),n=new Date();let a=n.getFullYear()-y;if(n<new Date(n.getFullYear(),m-1,d))a--;return a};
const THEMES={Graphite:["#16171a","#23252a","#e6e6e6","#8d99ae","#edf2f4"],Ember:["#1a0f0a","#2b1a12","#f5e6dc","#ff6b35","#ffb84d"],Moss:["#0f1a12","#1b2b20","#e2f0e4","#6bbf59","#c9e265"],Slate:["#151b24","#212b38","#e3eaf3","#5b8def","#9fc3ff"],Bone:["#efe9dc","#fbf7ec","#2a261f","#8a6f4e","#c2410c"],Ultraviolet:["#130d22","#221838","#efe6ff","#9d5cff","#ff5ccf"],Rust:["#1d120e","#2f1d16","#f1dfd3","#b7410e","#e0a458"],Midnight:["#05070f","#0e1424","#dfe7ff","#3b82f6","#22d3ee"]};
const BASE={
quad:["..a......a..","..aa....aa..","..aaaaaaaa..","..aeaaaaea..","..abbbbbba..","aaaaaaaaaaaa","aabaaaaaabaa","aa.aa..aa.aa","bb.bb..bb.bb"],
bird:["....aaaa....","...aaaaaa...","...aeaaea...","...aabbaa...","..aaaabaaa..",".aaaaaaaaaa.","aaabaaaabaaa",".aaaaaaaaaa.","...a....a...","..bb....bb.."],
blob:["....aaaa....","..aaaaaaaa..",".aaaaaaaaaa.",".aeaaaaaaea.","aaaaaaaaaaaa","aabaaaaaabaa","aaaabbbbaaaa",".aaaaaaaaaa.","..aaaaaaaa..","...bb..bb..."],
snake:["...aaaa.....","..aeaaea....","..aaaaaa....","...abba.....","....aaa.....","...aaaaaa...","..aabaaaaa..","...aaaaaaa..","....bbbbaa..","......aaa..."]};
// id,name,base,c1,c2,type(s=starter,l=level,k=best streak),n
const PETS=[["wolf","Wolf Pup","quad","#8d99ae","#e5e7eb","s"],["fox","Fox","quad","#e8742a","#f6e3c4","s"],["cat","Cat","quad","#c9a06b","#6b4b2a","s"],["frog","Frog","blob","#4caf50","#c8e6a0","s"],["turtle","Turtle","blob","#2e8b57","#c2a35c","s"],["hawk","Hawk","bird","#8b5a2b","#f2d16b","s"],["raccoon","Raccoon","quad","#6b6f78","#25272b","s"],["lizard","Lizard","snake","#7cb342","#f4d35e","s"],
["bear","Bear","quad","#6d4c41","#a1887f","l",3],["panther","Panther","quad","#212121","#5c6bc0","l",4],["boar","Boar","quad","#7b5e57","#d7ccc8","l",5],["axolotl","Axolotl","blob","#f4a6c0","#e86a92","l",6],["owl","Owl","bird","#9c7b54","#e8d9b5","l",7],["snake","Snake","snake","#3f7d3f","#d9d15c","l",8],["mantis","Mantis","snake","#8bc34a","#33691e","l",9],["ram","Ram","quad","#d7ccc8","#8d6e63","l",10],["crow","Crow","bird","#1c1c28","#6a6a8a","l",11],["gecko","Gecko","snake","#26a69a","#ffd54f","l",12],
["golem","Stone Golem","blob","#757575","#a1887f","k",14],["dragon","Dragon","snake","#c62828","#ffb300","k",30],["phoenix","Phoenix","bird","#ff6d00","#ffd600","k",30],["kraken","Kraken","blob","#5e35b1","#b39ddb","k",21],["yeti","Yeti","quad","#e3f2fd","#90caf9","k",21],["stag","Thunder Stag","quad","#ffd54f","#5d4037","k",45],["shadow","Shadow Wolf","quad","#1a1033","#7e57c2","k",60],["basilisk","Basilisk","snake","#2e7d32","#ff7043","k",100]];
// id,name,unit,goal,step,xp per unit
const EX=[["pu","Push-ups","reps",20,5,3],["sq","Squats","reps",40,10,1.5],["pl","Pull-ups / rows","reps",8,2,6],["lr","Leg raises","reps",15,5,2],["pk","Plank","sec",60,15,.5]];
const MIN=["mn","2-minute minimum","min",2,1,10];
const FOOD=[["Snack",10,15],["Meal",25,40],["Feast",60,100]];
const defS=()=>({xp:0,coins:0,hunger:80,t:Date.now(),streak:0,best:0,shields:1,lastDay:"",days:{},bonus:{},pet:"wolf",theme:{n:"Graphite",c:THEMES.Graphite.slice()},wk:null});
let P=null,S=defS(),UID=null,tab="home",mode="signup",step=1,F={pet:"wolf"},err="",rest=0,WL=null,tmr;
const need=l=>100+(l-1)*60,day=()=>S.days[dk()]||(S.days[dk()]={});
function lvl(){let l=1,x=S.xp;while(x>=need(l)){x-=need(l);l++}return{l,x,n:need(l)}}
const unlocked=p=>p[5]=="s"||(p[5]=="l"&&lvl().l>=p[6])||(p[5]=="k"&&S.best>=p[6]);
const req=p=>p[5]=="l"?"LV "+p[6]:"STREAK "+p[6];
function sprite(p,st,a1){const g=BASE[p[2]],c=document.createElement("canvas");c.width=14;c.height=12;const x=c.getContext("2d");
const f=(i,j)=>g[j]&&g[j][i]&&g[j][i]!==".";
if(st>=3){x.fillStyle=a1;for(let j=-1;j<=10;j++)for(let i=-1;i<=12;i++)if(!f(i,j)&&(f(i+1,j)||f(i-1,j)||f(i,j+1)||f(i,j-1)))x.fillRect(i+1,j+1,1,1)}
g.forEach((r,j)=>[...r].forEach((ch,i)=>{if(ch==".")return;x.fillStyle=ch=="a"?p[3]:ch=="b"?p[4]:"#111";x.fillRect(i+1,j+1,1,1)}));
if(st>=2){x.fillStyle="#ffd54f";x.fillRect(6,0,2,1)}
if(st>=4){x.fillStyle="#fff";[[0,2],[13,1],[1,10],[12,9]].forEach(([i,j])=>x.fillRect(i,j,1,1))}
return c.toDataURL()}
const stage=()=>{const x=(S.pp||{}).xp||0;return x>=1500?4:x>=600?3:x>=200?2:1};
const pet=id=>PETS.find(p=>p[0]==id)||PETS[0];
function toast(t){const e=$("#toast");e.textContent=t;e.style.display="block";clearTimeout(toast.t);toast.t=setTimeout(()=>e.style.display="none",1800)}
function apply(){const v=["--bg","--card","--text","--a1","--a2"];S.theme.c.forEach((c,i)=>document.documentElement.style.setProperty(v[i],c))}
let st;function save(){try{localStorage.setItem("ip.v1",JSON.stringify({P,S}))}catch(e){}
 if(sb&&UID){clearTimeout(st);st=setTimeout(()=>sb.from("game_state").upsert({user_id:UID,state:S}),800)}}
function rollover(){const t=dk();if(S.lastDay&&S.streak){const g=gap(t,S.lastDay);if(g==2&&S.shields>0){S.shields--;S.lastDay=dk(new Date(Date.now()-864e5));toast("Streak shield used")}else if(g>1)S.streak=0}
 const n=Date.now();S.hunger=Math.max(0,S.hunger-(n-S.t)/36e5*4);S.t=n}
function checkDay(){const t=dk(),d=day(),all=EX.every(e=>(d[e[0]]||0)>=e[3]);
 if((all||(d.mn||0)>=2||EX.some(e=>(d[e[0]]||0)>=e[3]))&&S.lastDay!==t){S.streak=S.lastDay&&gap(t,S.lastDay)==1?S.streak+1:1;S.lastDay=t;S.best=Math.max(S.best,S.streak);if(S.streak%7==0&&S.shields<3){S.shields++;toast("Streak shield earned")}}
 if(all&&!S.bonus[t]){S.bonus[t]=1;S.xp+=50;S.coins+=25;toast("ALL QUESTS! +50 XP")}}
function add(id,dir){const q=[...EX,MIN].find(e=>e[0]==id),d=day(),lv=lvl().l,cur=d[id]||0,nv=Math.max(0,cur+dir*q[4]),dl=nv-cur;if(!dl)return;d[id]=nv;
 const g=Math.round(dl*q[5]);S.xp=Math.max(0,S.xp+g);S.coins=Math.max(0,S.coins+Math.round(g/2));
 if(dir>0)toast("+"+g+" XP  +"+Math.round(g/2)+" COINS");checkDay();if(lvl().l>lv)toast("LEVEL "+lvl().l+"!");save();render()}
const fmt=s=>Math.floor(s/60)+":"+String(Math.floor(s%60)).padStart(2,"0");
function tickUI(){const a=$("#wt"),b=$("#rt");if(a&&S.wk)a.textContent=fmt((Date.now()-S.wk)/1e3);if(b){const r=Math.max(0,(rest-Date.now())/1e3);b.textContent=r>0?"REST "+fmt(r):"REST: OFF"}}
function questHTML(e){const v=(day()[e[0]]||0),done=v>=e[3];return `<div class="c q ${done?"done":""}"><div class="r"><b>${e[1]}</b><span class="m">${v}/${e[3]} ${e[2]}${done?" OK":""}</span></div><div class="bar"><i style="width:${Math.min(100,v/e[3]*100)}%"></i></div><div class="r"><button class="g" data-a="add" data-i="${e[0]}" data-d="-1">-</button><button style="flex:1" data-a="add" data-i="${e[0]}" data-d="1">+${e[4]} ${e[2]}</button></div></div>`}
function authHTML(){const sg=mode=="signup";let h=`<main><h1>FORGE</h1><p class="m" style="text-align:center">${sb?"":"DEMO MODE: no Supabase keys, data stays on this device"}</p><div class="c">`;
 const inp=(k,l,t="text")=>`<label>${l}</label><input data-k="${k}" type="${t}" value="${esc(F[k])}" autocomplete="off">`;
 if(!sg)h+=`<h2>LOG IN</h2>${inp("email","EMAIL","email")}${inp("password","PASSWORD","password")}<button data-a="login">START</button> <button class="g" data-a="mode">NEW GAME</button>`;
 else if(step==1)h+=`<h2>CREATE HERO 1/3</h2>${inp("first","FIRST NAME")}${inp("last","LAST NAME")}${inp("dob","DATE OF BIRTH","date")}${inp("email","EMAIL","email")}<button data-a="next">NEXT</button> ${sb?`<button class="g" data-a="mode">LOG IN</button>`:""}`;
 else if(step==2)h+=`<h2>ACCOUNT 2/3</h2>${inp("user","USERNAME")}${inp("pref","PREFERRED NAME")}${inp("password","PASSWORD (8+)","password")}<button class="g" data-a="back">BACK</button> <button data-a="next">NEXT</button>`;
 else h+=`<h2>PICK STARTER 3/3</h2><div class="grid">${PETS.filter(p=>p[5]=="s").map(p=>`<button class="pk ${F.pet==p[0]?"sel":""}" data-a="pick" data-i="${p[0]}"><img src="${sprite(p,1,"#fff")}"><br>${p[1]}</button>`).join("")}</div><br><label>COLOR PRESET</label><div class="sw">${Object.keys(THEMES).map(n=>`<button data-a="preset" data-i="${n}">${n}</button>`).join("")}</div><br><button class="g" data-a="back">BACK</button> <button data-a="signup">BEGIN</button>`;
